<UserControl x:Class="NGenProbe.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
  <Grid Background="#FF102040">
    <StackPanel Margin="96,64,96,64">
      <TextBlock Text="NGenProbe" FontSize="56" Foreground="White" />
      <TextBlock x:Name="ValueText" FontSize="32" Foreground="White" Margin="0,24,0,0" />
      <TextBlock x:Name="TextText" FontSize="32" Foreground="White" Margin="0,8,0,0" />
      <TextBlock x:Name="MagicText" FontSize="32" Foreground="White" Margin="0,8,0,0" />
      <TextBlock x:Name="VerdictText" FontSize="40" Foreground="#FFFFD860" Margin="0,24,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
