<UserControl x:Class="NGenBench.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
  <Grid Background="#FF102040">
    <StackPanel Margin="64,40,64,40">
      <TextBlock Text="NGenBench" FontSize="44" Foreground="White" />
      <TextBlock x:Name="SummaryText" FontSize="28" Foreground="#FFFFD860" Margin="0,8,0,0" />
      <TextBlock x:Name="ResultsText" FontSize="17" Foreground="White" Margin="0,12,0,0" TextWrapping="Wrap" />
      <TextBlock x:Name="TimingText" FontSize="22" Foreground="#FFB8E6B0" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
