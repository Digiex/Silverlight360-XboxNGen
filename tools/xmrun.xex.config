<?xml version="1.0" encoding="utf-8"?>
<!-- xcoreclr's settings for the zapper process (D:\xmrun.xex.config, read beside the package's default.xex): the
     runtime interprets every method it runs itself at NGen time, as it does on a retail console, instead of
     compiling it through the JIT being used for the image; only the methods it insists on compiling (JIT flag
     0x80) still come through the JIT. See docs/RESEARCH.md, "Run-time code generation". -->
<configuration>
  <runtime>
    <Interpret enabled="*"/>
  </runtime>
</configuration>
